{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Employee Attrition Prediction\n",
    "\n",
    "This notebook builds a machine learning pipeline to predict whether an employee will leave a company using the IBM HR Analytics Employee Attrition dataset.\n",
    "\n",
    "## What this notebook includes\n",
    "- Data loading\n",
    "- Data cleaning\n",
    "- Exploratory analysis\n",
    "- Preprocessing\n",
    "- Model training\n",
    "- Model evaluation\n",
    "- ROC and Precision-Recall analysis\n",
    "- Feature importance\n",
    "- Threshold tuning\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    f1_score,\n",
    "    roc_auc_score,\n",
    "    confusion_matrix,\n",
    "    classification_report,\n",
    "    roc_curve,\n",
    "    auc,\n",
    "    precision_recall_curve,\n",
    ")\n",
    "\n",
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load the dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "DATA_PATH = Path(\"WA_Fn-UseC_-HR-Employee-Attrition.csv\")\n",
    "\n",
    "if not DATA_PATH.exists():\n",
    "    raise FileNotFoundError(\n",
    "        \"Place WA_Fn-UseC_-HR-Employee-Attrition.csv in the same folder as this notebook before running.\"\n",
    "    )\n",
    "\n",
    "df = pd.read_csv(DATA_PATH)\n",
    "print(\"Shape:\", df.shape)\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Clean the dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "drop_cols = [c for c in [\"EmployeeCount\", \"EmployeeNumber\", \"Over18\", \"StandardHours\"] if c in df.columns]\n",
    "df = df.drop(columns=drop_cols).dropna().copy()\n",
    "\n",
    "print(\"Shape after cleaning:\", df.shape)\n",
    "print(\"\\nColumns:\")\n",
    "print(df.columns.tolist())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Quick exploratory analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Target distribution:\")\n",
    "print(df[\"Attrition\"].value_counts())\n",
    "print()\n",
    "print(df[\"Attrition\"].value_counts(normalize=True))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "ax = df[\"Attrition\"].value_counts().plot(kind=\"bar\", title=\"Class Distribution\")\n",
    "ax.set_xlabel(\"Attrition\")\n",
    "ax.set_ylabel(\"Count\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "numeric_summary = df.describe().T\n",
    "numeric_summary.head(10)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Prepare features and target"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X = df.drop(columns=[\"Attrition\"])\n",
    "y = df[\"Attrition\"].map({\"Yes\": 1, \"No\": 0})\n",
    "\n",
    "num_cols = X.select_dtypes(include=np.number).columns.tolist()\n",
    "cat_cols = [c for c in X.columns if c not in num_cols]\n",
    "\n",
    "print(\"Numeric columns:\", len(num_cols))\n",
    "print(\"Categorical columns:\", len(cat_cols))\n",
    "print(\"\\nCategorical columns:\", cat_cols)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Build preprocessing pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        (\n",
    "            \"num\",\n",
    "            Pipeline([\n",
    "                (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
    "                (\"scaler\", StandardScaler()),\n",
    "            ]),\n",
    "            num_cols,\n",
    "        ),\n",
    "        (\n",
    "            \"cat\",\n",
    "            Pipeline([\n",
    "                (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
    "                (\"onehot\", OneHotEncoder(handle_unknown=\"ignore\")),\n",
    "            ]),\n",
    "            cat_cols,\n",
    "        ),\n",
    "    ]\n",
    ")\n",
    "\n",
    "preprocessor"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Train-test split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X,\n",
    "    y,\n",
    "    test_size=0.20,\n",
    "    random_state=42,\n",
    "    stratify=y,\n",
    ")\n",
    "\n",
    "print(\"Train shape:\", X_train.shape)\n",
    "print(\"Test shape:\", X_test.shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Define models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "models = {\n",
    "    \"Logistic Regression\": LogisticRegression(\n",
    "        max_iter=3000,\n",
    "        class_weight=\"balanced\",\n",
    "        solver=\"liblinear\",\n",
    "        C=1.0,\n",
    "    ),\n",
    "    \"Random Forest\": RandomForestClassifier(\n",
    "        n_estimators=300,\n",
    "        max_depth=None,\n",
    "        min_samples_leaf=2,\n",
    "        class_weight=\"balanced\",\n",
    "        random_state=42,\n",
    "        n_jobs=1,\n",
    "    ),\n",
    "    \"Gradient Boosting\": GradientBoostingClassifier(\n",
    "        random_state=42,\n",
    "        n_estimators=200,\n",
    "        learning_rate=0.05,\n",
    "        max_depth=2,\n",
    "    ),\n",
    "}\n",
    "\n",
    "models"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Train models and collect metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "results = []\n",
    "fitted_models = {}\n",
    "\n",
    "for name, estimator in models.items():\n",
    "    pipe = Pipeline([\n",
    "        (\"preprocessor\", preprocessor),\n",
    "        (\"model\", estimator),\n",
    "    ])\n",
    "    pipe.fit(X_train, y_train)\n",
    "    fitted_models[name] = pipe\n",
    "\n",
    "    y_pred = pipe.predict(X_test)\n",
    "    y_score = pipe.predict_proba(X_test)[:, 1] if hasattr(pipe, \"predict_proba\") else y_pred\n",
    "\n",
    "    results.append({\n",
    "        \"Model\": name,\n",
    "        \"Accuracy\": accuracy_score(y_test, y_pred),\n",
    "        \"Precision\": precision_score(y_test, y_pred, zero_division=0),\n",
    "        \"Recall\": recall_score(y_test, y_pred, zero_division=0),\n",
    "        \"F1 Score\": f1_score(y_test, y_pred, zero_division=0),\n",
    "        \"ROC-AUC\": roc_auc_score(y_test, y_score),\n",
    "    })\n",
    "\n",
    "results_df = pd.DataFrame(results).sort_values(\"F1 Score\", ascending=False).reset_index(drop=True)\n",
    "results_df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Review classification reports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for name, model in fitted_models.items():\n",
    "    print(\"=\" * 80)\n",
    "    print(name)\n",
    "    y_pred = model.predict(X_test)\n",
    "    print(classification_report(y_test, y_pred, zero_division=0))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Confusion matrices"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for name, model in fitted_models.items():\n",
    "    y_pred = model.predict(X_test)\n",
    "    cm = confusion_matrix(y_test, y_pred)\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(5, 4))\n",
    "    im = ax.imshow(cm, interpolation=\"nearest\")\n",
    "    ax.figure.colorbar(im, ax=ax)\n",
    "    ax.set(\n",
    "        xticks=[0, 1],\n",
    "        yticks=[0, 1],\n",
    "        xticklabels=[\"Stayed\", \"Left\"],\n",
    "        yticklabels=[\"Stayed\", \"Left\"],\n",
    "        xlabel=\"Predicted\",\n",
    "        ylabel=\"Actual\",\n",
    "        title=f\"Confusion Matrix: {name}\",\n",
    "    )\n",
    "\n",
    "    thresh = cm.max() / 2.0 if cm.max() > 0 else 0.5\n",
    "    for i in range(cm.shape[0]):\n",
    "        for j in range(cm.shape[1]):\n",
    "            ax.text(\n",
    "                j,\n",
    "                i,\n",
    "                f\"{cm[i, j]}\",\n",
    "                ha=\"center\",\n",
    "                va=\"center\",\n",
    "                color=\"white\" if cm[i, j] > thresh else \"black\",\n",
    "            )\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 11. ROC curve comparison"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(7, 5))\n",
    "\n",
    "for name, model in fitted_models.items():\n",
    "    y_score = model.predict_proba(X_test)[:, 1]\n",
    "    fpr, tpr, _ = roc_curve(y_test, y_score)\n",
    "    roc_auc = auc(fpr, tpr)\n",
    "    plt.plot(fpr, tpr, label=f\"{name} (AUC = {roc_auc:.3f})\")\n",
    "\n",
    "plt.plot([0, 1], [0, 1], linestyle=\"--\")\n",
    "plt.xlabel(\"False Positive Rate\")\n",
    "plt.ylabel(\"True Positive Rate\")\n",
    "plt.title(\"ROC Curve Comparison\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 12. Precision-Recall curve comparison"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(7, 5))\n",
    "\n",
    "for name, model in fitted_models.items():\n",
    "    y_score = model.predict_proba(X_test)[:, 1]\n",
    "    precision, recall, _ = precision_recall_curve(y_test, y_score)\n",
    "    plt.plot(recall, precision, label=name)\n",
    "\n",
    "plt.xlabel(\"Recall\")\n",
    "plt.ylabel(\"Precision\")\n",
    "plt.title(\"Precision-Recall Curve Comparison\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 13. Best model selection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "best_model_name = results_df.iloc[0][\"Model\"]\n",
    "best_model = fitted_models[best_model_name]\n",
    "\n",
    "print(\"Best model by F1 Score:\", best_model_name)\n",
    "results_df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 14. Feature importance / coefficient analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "feature_names = best_model.named_steps[\"preprocessor\"].get_feature_names_out()\n",
    "estimator = best_model.named_steps[\"model\"]\n",
    "\n",
    "if hasattr(estimator, \"coef_\"):\n",
    "    importances = np.abs(estimator.coef_.ravel())\n",
    "    title = \"Absolute Logistic Regression Coefficients\"\n",
    "elif hasattr(estimator, \"feature_importances_\"):\n",
    "    importances = estimator.feature_importances_\n",
    "    title = \"Feature Importance\"\n",
    "else:\n",
    "    importances = None\n",
    "    title = None\n",
    "\n",
    "if importances is not None:\n",
    "    order = np.argsort(importances)[::-1][:15]\n",
    "    top_features = pd.DataFrame({\n",
    "        \"Feature\": np.array(feature_names)[order],\n",
    "        \"Importance\": importances[order],\n",
    "    })\n",
    "\n",
    "    plt.figure(figsize=(8, 6))\n",
    "    plt.barh(top_features[\"Feature\"][::-1], top_features[\"Importance\"][::-1])\n",
    "    plt.title(title)\n",
    "    plt.xlabel(\"Importance\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    print(top_features)\n",
    "else:\n",
    "    print(\"This model does not provide direct feature importances.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 15. Threshold tuning for the best model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "y_score = best_model.predict_proba(X_test)[:, 1]\n",
    "thresholds = np.linspace(0.1, 0.9, 17)\n",
    "\n",
    "threshold_metrics = []\n",
    "for t in thresholds:\n",
    "    preds = (y_score >= t).astype(int)\n",
    "    threshold_metrics.append({\n",
    "        \"Threshold\": t,\n",
    "        \"Precision\": precision_score(y_test, preds, zero_division=0),\n",
    "        \"Recall\": recall_score(y_test, preds, zero_division=0),\n",
    "        \"F1 Score\": f1_score(y_test, preds, zero_division=0),\n",
    "    })\n",
    "\n",
    "threshold_df = pd.DataFrame(threshold_metrics)\n",
    "threshold_df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(7, 5))\n",
    "plt.plot(threshold_df[\"Threshold\"], threshold_df[\"Precision\"], label=\"Precision\")\n",
    "plt.plot(threshold_df[\"Threshold\"], threshold_df[\"Recall\"], label=\"Recall\")\n",
    "plt.plot(threshold_df[\"Threshold\"], threshold_df[\"F1 Score\"], label=\"F1 Score\")\n",
    "plt.xlabel(\"Threshold\")\n",
    "plt.ylabel(\"Score\")\n",
    "plt.title(f\"Threshold Tuning: {best_model_name}\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 16. Final conclusion"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Final model ranking:\")\n",
    "print(results_df)\n",
    "\n",
    "print(\"\\nProject conclusion:\")\n",
    "print(\n",
    "    \"Machine learning can help predict employee attrition using HR data. \"\n",
    "    \"In this notebook, Logistic Regression delivered the best balance of precision and recall \"\n",
    "    \"based on F1 Score, while Gradient Boosting showed strong ROC-AUC performance.\"\n",
    ")"
   ]
  }
 ],
